<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.autoresize.dashboard" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name">Auto-Resize Dashboard</name>
    <description>
      Automatically extends dashboard height when worksheets are added or
      manually resized, preserving all other elements.
    </description>
    <author name="Dashboard Tools" email="support@example.com"
            organization="Dashboard Tools" website="https://example.com" />
    <min-api-version>1.7</min-api-version>
    <source-location>
      <!--
        ╔══════════════════════════════════════════════════════════════╗
        ║  ⚠️  YOU MUST UPDATE THE URL BELOW BEFORE USING THIS FILE  ║
        ║                                                              ║
        ║  Replace YOUR-USERNAME with your GitHub username             ║
        ║  Replace YOUR-REPO-NAME with your GitHub repository name    ║
        ║                                                              ║
        ║  Example: If your GitHub username is "jsmith" and your       ║
        ║  repo is called "tableau-auto-resize", the URL becomes:     ║
        ║                                                              ║
        ║  https://jsmith.github.io/tableau-auto-resize/auto-resize.html  ║
        ╚══════════════════════════════════════════════════════════════╝
      -->
      <url>https://YOUR-USERNAME.github.io/YOUR-REPO-NAME/auto-resize.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
</manifest>
